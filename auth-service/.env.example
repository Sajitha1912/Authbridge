# Auth service configuration
PORT=4000

# Secret used to sign/verify JWTs (change in any real deployment)
AUTH_JWT_SECRET=change-me

# Token lifetime in seconds (contract reports this as "expiresIn")
JWT_EXPIRES_IN_SECONDS=86400

# SQLite file (relative paths resolve against the auth-service folder)
DB_PATH=users.db

# Password hashing is internal to this service (scrypt) and needs no config.
